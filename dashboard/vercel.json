{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "routes": [
    {
      "src": "/api/submit",
      "dest": "/api/submit.js"
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.js"
    },
    {
      "src": "/api/agentone/fleet-submit",
      "dest": "/api/agentone/fleet-submit.js"
    },
    {
      "src": "/agentone/api/fleet-submit",
      "dest": "/agentone/api/fleet-submit.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
