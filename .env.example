# Energy Data API Keys
# Choose ONE based on your location (FREE options available!):
#
# 🇺🇸 USA (FREE): EIA API - Get from https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here
#
# 🇪🇺 Europe (FREE): ENTSO-E - Get from https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_api_key_here
#
# 🇬🇧 UK (NO KEY NEEDED): Carbon Intensity API is completely FREE!
#
# 🌍 Global (PAID): Electricity Maps - Get from https://www.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here

# Solana Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Mock Oracle Escrow Address (Replace with your test wallet for demo)
ORACLE_ESCROW_ADDRESS=YourDevWalletPublicKeyHere

# Dashboard API (Optional - for testing dashboard integration)
DASHBOARD_API_URL=http://localhost:3000/api/submit
DASHBOARD_FLEET_API_URL=http://localhost:3000/agentone/api/fleet-submit

# Stake Amount (in SOL)
STAKE_AMOUNT=0.01

# Premium Feature Price (in SOL)
PREMIUM_PRICE=0.001

# Fleet Treasury Address (for fleet creation fees)
# Replace with your devnet treasury wallet for testing
FLEET_TREASURY_ADDRESS=FLEETTreasuryPubkey11111111111111111111111111

# Query Cycle Interval (in minutes)
# How often to fetch weather & submit data (default: 15)
# For testing, you can set to 2 minutes: CYCLE_INTERVAL_MINUTES=2
CYCLE_INTERVAL_MINUTES=15
